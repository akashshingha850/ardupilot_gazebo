# Iris is X frame
FRAME_CLASS	     1
FRAME_TYPE	     1

# Match servo out for motors
MOT_PWM_MIN      1100
MOT_PWM_MAX      1900

# Gimbal on mount 1 has 3 DOF
MNT1_TYPE        1           # Servo
MNT1_PITCH_MAX   45
MNT1_PITCH_MIN   -135
MNT1_ROLL_MAX    30
MNT1_ROLL_MIN    -30
MNT1_YAW_MAX     160
MNT1_YAW_MIN     -160
MNT1_DEFLT_MODE  1           # Apply neutral mount target at boot
MNT1_NEUTRAL_X   45          # Sweep test: max upward target
MNT1_RETRACT_X   45          # Sweep test: max upward target
MNT1_NEUTRAL_Y   30          # Cancel startup roll bias
MNT1_RETRACT_Y   30          # Keep retract roll level

# Gimbal RC in
RC6_MAX          1900
RC6_MIN          1100
RC6_OPTION       0           # Disable RC override for startup mount control
RC7_MAX          1900
RC7_MIN          1100
RC7_OPTION       0           # Disable RC override for startup mount control
RC8_MAX          1900
RC8_MIN          1100
RC8_OPTION       0           # Disable RC override for startup mount control

# Gimbal servo out
SERVO9_FUNCTION  8           # Mount1Roll
SERVO10_FUNCTION 7           # Mount1Pitch
SERVO11_FUNCTION 6           # Mount1Yaw
